{
  "manifest_version": 3,
  "name": "PassoGuia — Gravador (scaffold)",
  "version": "0.0.0",
  "description": "Adaptador de captura via extensão para o núcleo do gravador PassoGuia. Scaffold: sem screenshot, sem backend.",
  "background": {
    "service_worker": "dist/servico.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/conteudo.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": ["activeTab", "scripting"],
  "host_permissions": []
}
