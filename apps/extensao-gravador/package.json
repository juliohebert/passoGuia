    "@types/chrome": "^0.2.9",
    "esbuild": "^0.25.0",
    "eslint": "^9.18.0",
    "happy-dom": "^20.14.3",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  }
}
